<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".HomeActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="155dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="30dp"
                android:paddingEnd="20dp"
                android:background="#162544">

                <TextView
                    android:id="@+id/txtGoodDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good Day"
                    android:textColor="#D6A928"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText,TextSizeCheck" />

                <TextView
                    android:id="@+id/txtUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Leeyah 👋"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/txtDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Thursday, 17 September 2026"
                    android:textColor="#C8CEDB"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- Search Bar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-25dp"
                android:layout_marginEnd="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="#E8E4DC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⌕"
                        android:textColor="#8A94AA"
                        android:textSize="30sp"
                        tools:ignore="HardcodedText,TextContrastCheck" />

                    <EditText
                        android:id="@+id/txtSearch"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/rounded_input"
                        android:hint="Search for a book..."
                        android:inputType="text"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#333333"
                        android:textColorHint="#888888"
                        android:textSize="14sp"
                        android:imeOptions="actionSearch"
                        android:singleLine="true"/>

                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>

            <!-- Statistics -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtBorrowedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#162544"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/txtBorrowed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Borrowed"
                            android:textColor="#687187"
                            android:textSize="12sp"
                            tools:ignore="HardcodedText,TextContrastCheck" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtReservedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#D6A928"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText,TextContrastCheck" />

                        <TextView
                            android:id="@+id/txtReserved"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reserved"
                            android:textColor="#687187"
                            android:textSize="12sp"
                            tools:ignore="HardcodedText,TextContrastCheck" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtHistoryCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#687187"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/txtHistory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="History"
                            android:textColor="#687187"
                            android:textSize="12sp"
                            tools:ignore="HardcodedText,TextContrastCheck" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Popular books heading -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtPopularBooks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Popular Books"
                    android:textColor="#162544"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/txtViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textColor="#D6A928"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText,TextContrastCheck" />

            </LinearLayout>

            <!-- Books -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <!-- Book 1 -->
                    <LinearLayout
                        android:layout_width="78dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="68dp"
                            android:layout_height="95dp"
                            app:cardCornerRadius="7dp"
                            app:cardBackgroundColor="#24436A">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="5dp">

                                <TextView
                                    android:id="@+id/txtBook1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Database\nSystems"
                                    android:textColor="#FFFFFF"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    tools:ignore="HardcodedText,SmallSp" />

                                <View
                                    android:layout_width="45dp"
                                    android:layout_height="2dp"
                                    android:layout_marginTop="7dp"
                                    android:background="#D6A928"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Korth"
                                    android:textColor="#FFFFFF"
                                    android:textSize="7sp"
                                    tools:ignore="HardcodedText,SmallSp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="68dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Database\nSystems..."
                            android:textColor="#111111"
                            android:textSize="12sp"
                            tools:ignore="HardcodedText,TextSizeCheck" />

                    </LinearLayout>

                    <!-- Book 2 -->
                    <LinearLayout
                        android:layout_width="85dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="68dp"
                            android:layout_height="95dp"
                            app:cardCornerRadius="7dp"
                            app:cardBackgroundColor="#174D40">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="5dp">

                                <View
                                    android:layout_width="45dp"
                                    android:layout_height="2dp"
                                    android:background="#D6A928"/>

                                <TextView
                                    android:id="@+id/txtBook2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="Engineering\nMathematics"
                                    android:textColor="#FFFFFF"
                                    android:textSize="8sp"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    tools:ignore="HardcodedText,SmallSp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="68dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Engineering\nMathematics"
                            android:textSize="12sp"
                            tools:ignore="HardcodedText,TextSizeCheck" />

                    </LinearLayout>

                    <!-- Book 3 -->
                    <LinearLayout
                        android:layout_width="85dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="68dp"
                            android:layout_height="95dp"
                            app:cardCornerRadius="7dp"
                            app:cardBackgroundColor="#641D1D">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="5dp">

                                <View
                                    android:layout_width="45dp"
                                    android:layout_height="2dp"
                                    android:background="#D6A928"/>

                                <TextView
                                    android:id="@+id/txtBook3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:text="Business\nLaw"
                                    android:textColor="#FFFFFF"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    tools:ignore="HardcodedText,SmallSp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Linda Edwards"
                                    android:textColor="#FFFFFF"
                                    android:textSize="6sp"
                                    tools:ignore="HardcodedText,SmallSp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="68dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Business\nLaw"
                            android:textSize="12sp"
                            tools:ignore="HardcodedText,TextSizeCheck" />

                    </LinearLayout>

                    <!-- Book 4 -->
                    <LinearLayout
                        android:layout_width="85dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="68dp"
                            android:layout_height="95dp"
                            app:cardCornerRadius="7dp"
                            app:cardBackgroundColor="#174C35">

                            <TextView
                                android:id="@+id/txtBook4"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="Psychology:\nThe Science\nof Mind and\nBehaviour"
                                android:textColor="#FFFFFF"
                                android:textSize="7sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText,SmallSp" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="68dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Psychology:\nThe Science..."
                            android:textSize="12sp"
                            tools:ignore="HardcodedText,TextSizeCheck" />

                    </LinearLayout>

                    <!-- Book 5 -->
                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="68dp"
                            android:layout_height="95dp"
                            app:cardCornerRadius="7dp"
                            app:cardBackgroundColor="#193352">

                            <TextView
                                android:id="@+id/txtBook5"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="Introduction\nto\nAlgorithms"
                                android:textColor="#FFFFFF"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText,SmallSp" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="68dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Introduction\nto..."
                            android:textSize="12sp"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Browse Categories -->
            <TextView
                android:id="@+id/txtBrowseCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="5dp"
                android:text="Browse Categories"
                android:textColor="#162544"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- Category 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="102dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="15dp">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="💻"
                            android:textSize="24sp"
                            tools:ignore="HardcodedText,TextSizeCheck" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/categoryComputerScience"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Computer\nScience"
                                android:textColor="#162544"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3 books"
                                android:textColor="#687187"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText,TextContrastCheck" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="102dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="15dp">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="📚"
                            android:textSize="24sp"
                            tools:ignore="HardcodedText,TextSizeCheck" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/categoryBusiness"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Business"
                                android:textColor="#162544"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 books"
                                android:textColor="#687187"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText,TextContrastCheck" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Category 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="15dp">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="📐"
                            android:textSize="23sp"
                            tools:ignore="HardcodedText,TextContrastCheck" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/categoryMathematics"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mathematics"
                                android:textColor="#162544"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText,TextContrastCheck" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 book"
                                android:textColor="#687187"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="15dp"
                        tools:ignore="TooManyViews">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="⚖️"
                            android:textSize="23sp"
                            tools:ignore="HardcodedText,TextContrastCheck" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/categoryLaw"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Law"
                                android:textColor="#162544"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText,TextContrastCheck" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 book"
                                android:textColor="#687187"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:weightSum="4">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="#D6A928"
            android:textSize="12sp"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <TextView
            android:id="@+id/navBrowse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌕\nBrowse"
            android:textColor="#687187"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/navMyBooks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣\nMy Books"
            android:textColor="#687187"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙\nProfile"
            android:textColor="#687187"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</LinearLayout>





